# Copy to .env only if using a vision model. Never commit .env.
# No model or key is assumed. Local pixel measurement and OCR work without these.
STUDIO_PORT=4174
STUDIO_VISION_BASE_URL=https://api.openai.com/v1
STUDIO_VISION_MODEL=
STUDIO_VISION_KEY=
# responses or chat (OpenAI-compatible Chat Completions)
STUDIO_VISION_PROTOCOL=responses
