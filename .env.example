# Optional server-side vision model. Never commit .env.
# Users can instead configure their own model/key in page memory.
STUDIO_PORT=4174
STUDIO_VISION_BASE_URL=https://api.openai.com/v1
STUDIO_VISION_MODEL=
STUDIO_VISION_KEY=
# responses or chat (OpenAI-compatible Chat Completions)
STUDIO_VISION_PROTOCOL=responses
